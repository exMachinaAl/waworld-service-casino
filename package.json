{
  "name": "world-arcade-engine",
  "version": "0.2.0-react",
  "private": true,
  "type": "module",
  "description": "Standalone virtual-credit arcade with WhatsApp/Web session handoff",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite src/server.mjs",
    "test": "node --experimental-sqlite --test tests/*.test.mjs",
    "check": "node --experimental-sqlite scripts/check.mjs && node scripts/check-web.mjs",
    "build:web": "node scripts/build-web.mjs",
    "dev:web": "npm --prefix web run dev",
    "test:web:source": "node scripts/check-web.mjs"
  }
}
