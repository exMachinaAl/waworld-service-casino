# Copy only for fresh install, or run INSTALL.bat to generate a random service token.
WAE_HOST=127.0.0.1
WAE_PORT=8787
WAE_DEMO_MODE=1
WAE_COOKIE_SECURE=0
WAE_SERVICE_TOKEN=
# Default OFF. Local administration is separate from test grants.
WAE_ADMIN_ENABLED=0
WAE_ADMIN_TEST_GRANTS=0
LOTTERY_ENABLED=false
# Behind TLS: set demo 0, cookie secure 1, and the exact externally visible origin.
# WAE_PUBLIC_ORIGIN=https://example.invalid
